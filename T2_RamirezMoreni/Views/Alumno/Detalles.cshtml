
@model T2_RamirezMoreni.Models.Alumno

@{
    ViewBag.Title = "Información del Alumno";
}

<div style="width: 650px; margin: 35px auto;">

    <div style="text-align: center; margin-bottom: 25px;">
        <h2>Información del Alumno</h2>
        <p style="color: #777;">
            Datos registrados del estudiante
        </p>
    </div>

    <div style="border: 1px solid #ddd; border-radius: 12px; padding: 30px;">

        <div class="row">
            <div class="col-md-6">
                <strong>DNI</strong>
                <p>@Model.dni</p>
            </div>

            <div class="col-md-6">
                <strong>Ciclo</strong>
                <p>@Model.ciclo</p>
            </div>
        </div>

        <hr />

        <div class="row">
            <div class="col-md-6">
                <strong>Nombres</strong>
                <p>@Model.nombres</p>
            </div>

            <div class="col-md-6">
                <strong>Apellidos</strong>
                <p>@Model.apellidos</p>
            </div>
        </div>

        <hr />

        <div>
            <strong>Carrera</strong>
            <p>@Model.carrera</p>
        </div>

        <br />

        <div style="text-align: right;">

            @Html.ActionLink(
                "Volver al listado",
                "Index",
                null,
                new { @class = "btn btn-default" }
            )

            @Html.ActionLink(
                "Modificar datos",
                "Actualizar",
                new { dni = Model.dni },
                new { @class = "btn btn-warning" }
            )

        </div>

    </div>

</div>
```
